# Vertex AI / Google Cloud ADC is preferred. No key file is copied into the image.
# Cloud Run uses its attached service account; local setup may use gcloud ADC.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
PORT=8080
# Optional: exact deployed HTTPS origin for browser POST checks.
# PUBLIC_ORIGIN=https://your-service.run.app
# Local alternative only: unset GOOGLE_CLOUD_PROJECT and provide a server-side key.
# GEMINI_API_KEY=
# Never place a real key in this tracked example, public/, logs, or Git.
